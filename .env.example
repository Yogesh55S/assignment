# Environment Configuration Template
# WARNING: NEVER commit real credentials or .env files to source control!
# Copy this file to .env at the repository root and fill in your local values.

# Application environment ('development' | 'production' | 'test')
NODE_ENV=development

# Port for the Express backend server
PORT=5000

# MongoDB Connection String (Atlas or local replica set)
# SECURITY NOTE: MONGODB_URI must stay server-side only. Never expose to client.
# Example: mongodb+srv://<username>:<password>@cluster.mongodb.net/interview_prep?retryWrites=true&w=majority
MONGODB_URI=

# Secret key used for signing JWT authentication tokens
# SECURITY NOTE: JWT_SECRET must be a long random secret (at least 32 characters).
# Example: openssl rand -base64 32
JWT_SECRET=

# Allowed frontend origin for CORS and cookie credentials
CLIENT_URL=http://localhost:3000

# API key for the LLM service (OpenAI, Anthropic, Gemini, etc.)
# SECURITY NOTE: LLM_API_KEY is server-side only. Never expose to client.
LLM_API_KEY=

# Provider identifier for LLM service ('gemini' | 'openrouter')
LLM_PROVIDER=openrouter

# Model identifier for question generation and synthesis
# Example: openai/gpt-4o or gemini-2.5-flash
LLM_MODEL=openai/gpt-4o

# Allow fetching local or private network URLs for testing company pages
# SECURITY NOTE: ALLOW_LOCAL_FETCH should be true for assessment batch tests that may use local company URLs, but must be false in production.
ALLOW_LOCAL_FETCH=true
